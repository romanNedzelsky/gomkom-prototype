{
  "$meta": {
    "name": "HR AI governance prototype — design tokens",
    "issue": "GOM-19",
    "parent": "GOM-12",
    "status": "validation prototype only — not a production design system",
    "updated": "2026-09-29"
  },
  "color": {
    "bg": { "value": "#f6f7f9", "tailwind": "slate-50-ish", "use": "app canvas" },
    "panel": { "value": "#ffffff", "use": "cards, tables, sheets" },
    "ink": { "value": "#0f172a", "use": "primary text, headings", "contrastOnPanel": "16.9:1" },
    "ink-2": { "value": "#334155", "use": "secondary text", "contrastOnPanel": "10.4:1" },
    "muted": { "value": "#5b6775", "use": "labels, captions, meta", "contrastOnPanel": "5.6:1" },
    "line": { "value": "#e3e7ec", "use": "borders, dividers (non-text, no contrast req)" },
    "line-strong": { "value": "#cbd3dc", "use": "table header rule, input borders" },
    "brand": { "value": "#1d4ed8", "use": "primary action, links, active nav", "contrastOnPanel": "6.5:1" },
    "brand-ink": { "value": "#17368f", "use": "text on brand-soft", "contrastOnBrandSoft": "9.1:1" },
    "brand-soft": { "value": "#eef2ff", "use": "active nav bg, brand pill bg" },
    "focus": { "value": "#1d4ed8", "use": "3px focus ring, 2px offset" }
  },
  "status": {
    "evidenced": { "fg": "#15803d", "bg": "#eaf6ee", "border": "#bcdfc8", "glyph": "check", "label": "Evidenced", "contrast": "4.8:1" },
    "partial": { "fg": "#8a4708", "bg": "#fdf3e3", "border": "#eccfa3", "glyph": "half", "label": "Partial", "contrast": "6.2:1" },
    "missing": { "fg": "#b91c1c", "bg": "#fdecec", "border": "#f0bcbc", "glyph": "cross", "label": "Missing", "contrast": "5.4:1" }
  },
  "severity": {
    "high": { "fg": "#b91c1c", "bg": "#fdecec", "border": "#f0bcbc", "label": "High" },
    "medium": { "fg": "#8a4708", "bg": "#fdf3e3", "border": "#eccfa3", "label": "Medium" },
    "low": { "fg": "#475569", "bg": "#f1f5f9", "border": "#d5dde6", "label": "Low" }
  },
  "decisionRole": {
    "note": "The spine of the product. Always rendered as a labelled pill, never colour-only.",
    "informs": { "label": "Informs a human decision", "fg": "#334155", "bg": "#f1f5f9", "border": "#cbd3dc" },
    "ranks": { "label": "Ranks or filters candidates", "fg": "#17368f", "bg": "#eef2ff", "border": "#c3cdf7" },
    "decides": { "label": "Decides autonomously", "fg": "#b91c1c", "bg": "#fdecec", "border": "#f0bcbc" }
  },
  "typography": {
    "family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "scale": {
      "caption": { "size": "12px", "lh": "16px", "weight": 500, "tracking": "0.02em" },
      "label": { "size": "12px", "lh": "16px", "weight": 600, "tracking": "0.06em", "transform": "uppercase" },
      "body-sm": { "size": "13px", "lh": "20px", "weight": 400 },
      "body": { "size": "14px", "lh": "22px", "weight": 400 },
      "subhead": { "size": "16px", "lh": "24px", "weight": 600 },
      "h2": { "size": "20px", "lh": "28px", "weight": 650 },
      "h1": { "size": "26px", "lh": "34px", "weight": 660, "tracking": "-0.01em" },
      "stat": { "size": "30px", "lh": "36px", "weight": 660, "tracking": "-0.02em" }
    }
  },
  "space": { "unit": "4px", "scale": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64] },
  "radius": { "sm": "4px", "md": "8px", "lg": "12px", "pill": "999px" },
  "shadow": {
    "none": "none",
    "card": "0 1px 2px rgba(15,23,42,.05)",
    "raised": "0 8px 24px rgba(15,23,42,.10)"
  },
  "layout": {
    "approach": "desktop-first; used at a laptop, not a phone",
    "appMaxWidth": "1440px",
    "sidebarWidth": "232px",
    "contentGutter": "32px",
    "breakpoints": { "laptop": "1280px", "smallLaptop": "1024px", "belowSupported": "<1024px shows a 'best viewed on a laptop' notice" },
    "tableRowHeight": "52px"
  },
  "components": {
    "note": "shadcn/ui equivalents named so an engineer can map 1:1 if this ever gets built.",
    "map": {
      "register table": "Table + Badge + Input (search) + ToggleGroup (filters)",
      "decision role pill": "Badge variant=outline with explicit label text",
      "status pill": "Badge + inline glyph (never colour-only)",
      "boundary strip": "Alert variant=default, sticky, non-dismissible",
      "triage stepper": "custom Stepper + Collapsible (citation on demand) + Card",
      "confirm action": "Button + AlertDialog + toast (sonner)",
      "evidence checklist": "Table + ToggleGroup filter + Progress",
      "gap dashboard": "Card (stat tiles) + Table + Select (group by)",
      "export": "Card + Checkbox list + Button + Progress + Alert (gap warning)",
      "activity": "ol timeline, no edit/delete affordance (append-only)"
    }
  },
  "a11y": {
    "minContrast": "4.5:1 for all text; verified per token above",
    "focus": "visible 3px ring, 2px offset, never removed",
    "colourIndependence": "every status and severity carries a text label and a glyph",
    "keyboard": "all interactive elements are native button/a/input; stepper is arrow-key navigable; no click-only affordances",
    "landmarks": "header / nav / main / footer, skip-to-content link first in tab order",
    "liveRegions": "aria-live=polite on triage confirmation and export result"
  },
  "outOfScope": [
    "ATS / HCM integration screens",
    "bias or fairness testing screens",
    "any employee-level or candidate-level personal data",
    "billing, plans, seats, invoices",
    "mobile layouts",
    "German localisation (EN only this sprint)"
  ]
}
